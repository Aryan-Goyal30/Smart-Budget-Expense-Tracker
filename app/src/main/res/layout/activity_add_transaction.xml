<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tvAddTransactionTitle"
            style="@style/SmartBudget.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add transaction" />

        <TextView
            android:id="@+id/tvAddTransactionSubtitle"
            style="@style/SmartBudget.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Record money coming in or going out" />

        <!-- Type: Expense / Income switch (two RadioButtons styled as segments) -->
        <RadioGroup
            android:id="@+id/rgTransactionType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_segment_group"
            android:orientation="horizontal"
            android:padding="4dp">

            <RadioButton
                android:id="@+id/rbExpense"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_expense"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="Expense"
                android:textColor="@color/segment_expense_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbIncome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_income"
                android:button="@null"
                android:gravity="center"
                android:text="Income"
                android:textColor="@color/segment_income_text"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RadioGroup>

        <!-- Amount (the most important field, so it is the largest) -->
        <TextView
            android:id="@+id/tvAmountLabel"
            style="@style/SmartBudget.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Amount" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SmartBudget.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:prefixText="₹"
            app:expandedHintEnabled="false"
            app:prefixTextAppearance="@style/TextAppearance.Material3.HeadlineMedium">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:paddingVertical="18dp"
                android:textSize="28sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category -->
        <TextView
            android:id="@+id/tvCategoryLabel"
            style="@style/SmartBudget.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Category" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SmartBudget.TextField.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select a category"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date: not typeable, tapping it opens a date picker -->
        <TextView
            android:id="@+id/tvDateLabel"
            style="@style/SmartBudget.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Date" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDate"
            style="@style/SmartBudget.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconContentDescription="Select date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:hint="dd/mm/yyyy" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescriptionLabel"
            style="@style/SmartBudget.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Description" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SmartBudget.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Optional description"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Actions -->
        <Button
            android:id="@+id/btnSaveTransaction"
            style="@style/SmartBudget.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save transaction" />

        <Button
            android:id="@+id/btnCancelTransaction"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancel"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
