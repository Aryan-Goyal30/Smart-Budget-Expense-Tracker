<?xml version="1.0" encoding="utf-8"?>
<!-- One category under the donut: ● Name ...... 50.8%  ₹7,000.00
                                    ▬▬▬▬▬▬▬▬▬▬▬▬ (share bar in the same colour) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewCategoryColor"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_circle"
            tools:backgroundTint="@color/chart_1" />

        <TextView
            android:id="@+id/tvAnalyticsCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="Travel" />

        <TextView
            android:id="@+id/tvAnalyticsPercent"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="43.6%" />

        <TextView
            android:id="@+id/tvAnalyticsTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="104dp"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="₹8,200.00" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressCategoryShare"
        style="@style/SmartBudget.ProgressBar.Thin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="8dp"
        android:max="100"
        tools:progress="44" />

</LinearLayout>
