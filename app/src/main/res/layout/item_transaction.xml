<?xml version="1.0" encoding="utf-8"?>
<!-- One ledger row: [initial]  Category ..................... Amount
                                date · description        [edit] [delete] -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp">

    <!-- Category initial in a circle tinted by type -->
    <TextView
        android:id="@+id/tvTransactionIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_circle"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:backgroundTint="@color/expense_container"
        tools:text="T"
        tools:textColor="@color/color_expense"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Line 1: Category ........ Amount -->
    <TextView
        android:id="@+id/tvTransactionCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Travel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvTransactionIcon"
        app:layout_constraintEnd_toStartOf="@id/tvTransactionAmount" />

    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="−₹7,000.00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Line 2: date · description ........ [edit] [delete] -->
    <TextView
        android:id="@+id/tvTransactionDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        tools:text="06/10/2026"
        app:layout_constraintTop_toTopOf="@id/btnDeleteTransaction"
        app:layout_constraintBottom_toBottomOf="@id/btnDeleteTransaction"
        app:layout_constraintStart_toStartOf="@id/tvTransactionCategory" />

    <TextView
        android:id="@+id/tvTransactionDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        tools:text="  ·  Weekend trip"
        app:layout_constraintTop_toTopOf="@id/tvTransactionDate"
        app:layout_constraintStart_toEndOf="@id/tvTransactionDate"
        app:layout_constraintEnd_toStartOf="@id/btnEditTransaction" />

    <!-- Subtle actions -->
    <Button
        android:id="@+id/btnEditTransaction"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Edit transaction"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="8dp"
        app:icon="@drawable/ic_edit"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/tvTransactionAmount"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteTransaction" />

    <Button
        android:id="@+id/btnDeleteTransaction"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="-8dp"
        android:contentDescription="Delete transaction"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="8dp"
        app:icon="@drawable/ic_delete"
        app:iconSize="18dp"
        app:iconTint="@color/color_expense"
        app:layout_constraintTop_toBottomOf="@id/tvTransactionAmount"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider between rows, lined up with the text -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintTop_toBottomOf="@id/btnDeleteTransaction"
        app:layout_constraintStart_toStartOf="@id/tvTransactionCategory"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
